# Copy to elder-safety/.env and enter the RTSP URL verified for your camera.
# The URL must include device credentials; never commit the real .env file.
RTSP_URL=

# Optional relay to a separately deployed notification backend (not bundled).
# Empty credentials disable the relay without preventing local preview.
SAFETY_BACKEND_URL=http://127.0.0.1:8010
SAFETY_DEVICE_ID=camera_001
SAFETY_DEVICE_TOKEN=
