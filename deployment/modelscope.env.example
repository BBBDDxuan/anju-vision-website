# Add settings to Studio variables. VLM_API_KEY belongs in platform Secrets only.
CLOUD_MODE=true
DATA_DIR=/mnt/workspace/anju-data
MAX_CONCURRENCY=1
MAX_MODEL_CALLS_PER_DAY=100
VLM_BILLING_MODE=request_limited
VLM_PROVIDER=qwen
VLM_ENABLE_NETWORK=false
# Match the service and key you actually use, then enable network access.
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.8-max
VLM_REVIEW_MODEL=qwen3.8-max
FACE_RECOGNITION_ENABLED=false
HYBRID_SAFETY_ENABLED=true
SAFETY_DEVICE=cpu
# Prefer the exact runtime hostname assigned to your Studio.
APP_ALLOWED_HOSTS=localhost,127.0.0.1,*.ms.show
CLOUD_COOKIE_SECURE=true
MAX_UPLOAD_MB=0
MAX_VIDEO_SECONDS=0
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
