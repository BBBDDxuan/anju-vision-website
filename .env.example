# Public example only. Real credentials belong in .env.
VLM_PROVIDER="qwen"
VLM_API_KEY=""
VLM_BASE_URL="https://maas.qianwenaiapi.com/compatible-mode/v1"
VLM_MODEL="qwen3.8-max"
VLM_ENABLE_NETWORK="false"
# Text-only answers over saved records use the same model and shared daily budget.
# Set false to keep only local rule retrieval and person-candidate statistics.
RECORD_QA_ENABLED=true
DATA_DIR="./data"
# 0 disables the application duration limit.
MAX_VIDEO_SECONDS=0
MAX_FRAME_REFERENCES="128"
MAX_MODEL_CALLS_PER_VIDEO="12"
MAX_CONCURRENCY="2"
REQUEST_TIMEOUT_SECONDS="90"
MAX_COST_RMB_PER_VIDEO="2"
MAX_COST_RMB_PER_DAY="5"

# Strict request limits; RMB cost is unknown until account pricing is verified.
# Optional independent review model; one request per user-triggered verification.
VLM_REVIEW_MODEL=qwen3.8-max
# Only needed in priced mode when the review model differs from VLM_MODEL.
VLM_REVIEW_COST_CONFIRMED=false
VLM_REVIEW_INPUT_RMB_PER_MILLION=0
VLM_REVIEW_OUTPUT_RMB_PER_MILLION=0
VLM_BILLING_MODE=request_limited
MAX_MODEL_CALLS_PER_DAY=24
PERSON_ABSENCE_ALERT_SECONDS=300
MAX_OUTPUT_TOKENS_PER_VIDEO=8192
VLM_MAX_RETRIES=1
VIDEO_SAMPLING_FPS=1
VIDEO_WINDOW_SECONDS=8
VIDEO_WINDOW_STRIDE_SECONDS=6
# Short recordings (<= LONG_VIDEO_THRESHOLD_SECONDS): denser safety sampling.
# Long recordings retain their separate activity-filtered profile below.
SAFETY_SAMPLING_ENABLED=true
SAFETY_SAMPLING_FPS=4
SAFETY_WINDOW_SECONDS=4
SAFETY_WINDOW_STRIDE_SECONDS=3

# Optional priced mode: verify your own account prices before enabling.
VLM_COST_CONFIRMED=false
VLM_INPUT_RMB_PER_MILLION=0
VLM_OUTPUT_RMB_PER_MILLION=0
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
# FFPROBE_PATH=C:/path/to/ffprobe.exe
# 0 disables the application file-size limit; free-space checks remain enabled.
MAX_UPLOAD_MB=0
MEDIA_TIMEOUT_SECONDS='1800'
MAX_SAMPLED_FRAMES='100000'
VLM_OUTPUT_TOKENS_PER_WINDOW='4096'
LONG_VIDEO_THRESHOLD_SECONDS='120'
LONG_VIDEO_SAMPLING_FPS='.5'
LONG_VIDEO_WINDOW_SECONDS='30'
LONG_VIDEO_WINDOW_STRIDE_SECONDS='28'

# Local static filtering applies only above LONG_VIDEO_THRESHOLD_SECONDS.
ACTIVITY_FILTER_ENABLED=true
ACTIVITY_FILTER_FPS=1
ACTIVITY_FILTER_PIXEL_THRESHOLD=18
ACTIVITY_FILTER_CHANGE_RATIO=0.003
ACTIVITY_FILTER_REVIEW_SECONDS=300
ACTIVITY_FILTER_PERSON_REVIEW_SECONDS=60
ACTIVITY_FILTER_POSTROLL_SECONDS=30

# Unified safety cascade: local fall/help/fire candidates, then Qwen review.
# Existing credentials/network consent/billing limits above remain mandatory.
HYBRID_SAFETY_ENABLED=true
# Optional overrides; defaults use elder-safety/.venv-gpu and the generated config.
# Run scripts/configure_safety.py after installing the detector and local weights.
# SAFETY_PYTHON="C:/path/to/anju-vision-website/elder-safety/.venv-gpu/Scripts/python.exe"
# SAFETY_MODEL_CONFIG="C:/path/to/anju-vision-website/elder-safety/ai-service/config.camera-gpu.json"
