# frontend/dist/ is intentionally tracked for serving by the Python backend.

# Runtime assets only. Real .env files remain local and must never be committed.
!/elder-safety/weights/*.pt
!/elder-safety/tools/
!/elder-safety/tools/ffmpeg/
!/elder-safety/tools/ffmpeg/*
# Owner request: no camera videos or video chunks in Git.
/examples/repro-video/
*.part[0-9][0-9]

# Local detector test output; never publish generated evidence.
/elder-safety/ai-service/var/

# Approved website demo assets only; runtime camera recordings remain ignored.
!/frontend/public/demo/videos/fall.mp4
!/frontend/public/demo/videos/help.mp4
!/frontend/public/demo/videos/fire.mp4
!/frontend/dist/demo/videos/fall.mp4
!/frontend/dist/demo/videos/help.mp4
!/frontend/dist/demo/videos/fire.mp4

# Local redesign snapshots are not part of the project.
/frontend/.backup-*/

# Private local APK updater: APKs, signer pin and generated manifest stay on this PC.
/runtime/app-updates/
*.apk

# Face weights are prepared locally with scripts/prepare_face_models.py.
/models/face-recognition/*.onnx
/.pytest-contact*/
