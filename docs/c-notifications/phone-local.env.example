# Safe reference only. For a NEW checkout copy to the website root as .env.
# Preserve an existing .env. Fill real credentials locally; never commit them.
# See ENV_CONFIGURATION.md. Network calls remain disabled by default.
VLM_PROVIDER="qwen"
VLM_API_KEY=
VLM_BASE_URL="https://maas.qianwenaiapi.com/compatible-mode/v1"
VLM_MODEL='qwen3.8-max'
VLM_ENABLE_NETWORK=false
VLM_COST_CONFIRMED="false"
VLM_INPUT_RMB_PER_MILLION="0"
VLM_OUTPUT_RMB_PER_MILLION="0"
MAX_COST_RMB_PER_VIDEO="2"
MAX_COST_RMB_PER_DAY="5"
DATA_DIR='data'
MAX_VIDEO_SECONDS=0
MAX_FRAME_REFERENCES='256'
MAX_MODEL_CALLS_PER_VIDEO='16'
MAX_CONCURRENCY="2"
REQUEST_TIMEOUT_SECONDS='90'
VLM_BILLING_MODE="request_limited"
MAX_MODEL_CALLS_PER_DAY=100
VLM_MAX_RETRIES="1"
MAX_UPLOAD_MB=0
MEDIA_TIMEOUT_SECONDS='1800'
MAX_SAMPLED_FRAMES='100000'
VLM_OUTPUT_TOKENS_PER_WINDOW='4096'
LONG_VIDEO_THRESHOLD_SECONDS='120'
LONG_VIDEO_SAMPLING_FPS='.5'
LONG_VIDEO_WINDOW_SECONDS='30'
LONG_VIDEO_WINDOW_STRIDE_SECONDS='28'
MAX_OUTPUT_TOKENS_PER_VIDEO='32768'
VLM_REVIEW_MODEL='qwen3.8-max'
CLOUD_STORAGE_MB=0
SAFETY_MODEL_CONFIG='runtime/team-camera.json'
SAFETY_PYTHON='elder-safety/.venv-gpu/Scripts/python.exe'
FFMPEG_PATH='elder-safety/tools/ffmpeg/ffmpeg.exe'
FFPROBE_PATH='elder-safety/tools/ffmpeg/ffprobe.exe'
# Optional independent async push module supplied by C. Credentials stay private.
APP_ALERT_PUSH_HANDLER=

# This machine has validated D:/Anaconda/envs/gear_test/python.exe.
# New environments must install the detector requirements before use.
# Other computers must supply their own validated detector interpreter.

# Extra main-service options (same defaults as backend/config.py).
HYBRID_SAFETY_ENABLED=true
RECORD_QA_ENABLED=true
VLM_REVIEW_INPUT_RMB_PER_MILLION=0
VLM_REVIEW_OUTPUT_RMB_PER_MILLION=0
VLM_REVIEW_COST_CONFIRMED=false
VIDEO_SAMPLING_FPS=1
VIDEO_WINDOW_SECONDS=8
VIDEO_WINDOW_STRIDE_SECONDS=6
SAFETY_SAMPLING_ENABLED=true
SAFETY_SAMPLING_FPS=4
SAFETY_WINDOW_SECONDS=4
SAFETY_WINDOW_STRIDE_SECONDS=3
ACTIVITY_FILTER_ENABLED=true
ACTIVITY_FILTER_FPS=1
ACTIVITY_FILTER_PIXEL_THRESHOLD=18
ACTIVITY_FILTER_CHANGE_RATIO=.003
ACTIVITY_FILTER_REVIEW_SECONDS=300
ACTIVITY_FILTER_PERSON_REVIEW_SECONDS=60
ACTIVITY_FILTER_POSTROLL_SECONDS=30
PERSON_ABSENCE_ALERT_SECONDS=300
APP_ALLOWED_HOSTS='127.0.0.1,localhost,[::1]'
APP_ALLOWED_ORIGINS='http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000'
CLOUD_MODE=false
APP_TRUSTED_PROXY_CIDRS=
CLOUD_COOKIE_SECURE=true
CLOUD_MAX_VIDEOS=20
CLOUD_VIDEOS_PER_VISITOR=3

# Alternative key, only if VLM_API_KEY is blank:
# DASHSCOPE_API_KEY=
# The launcher supplies APP_LAN_TOKEN from the private .env.phone.
# APP_SAFETY_INTERNAL_URL is set by the launcher, not a phone-facing URL.

# Optional real FCM; enabling requires native App setup and private credentials.
APP_FCM_ENABLED=false
APP_FCM_CREDENTIALS=
APP_FCM_ORIGIN=
