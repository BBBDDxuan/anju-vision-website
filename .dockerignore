!backend/
backend/*
!backend/*.py
!backend/providers/
backend/providers/*
!backend/providers/*.py
!backend/push_notifications/
backend/push_notifications/*
!backend/push_notifications/*.py
!schemas/
!schemas/**
!prompts/
!prompts/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/index.html
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!elder-safety/
!elder-safety/ai-service/
!elder-safety/ai-service/config.team.json
!elder-safety/ai-service/ai_service/
elder-safety/ai-service/ai_service/*
!elder-safety/ai-service/ai_service/*.py
!elder-safety/scripts/
