# Copy to .env; fill shared credentials privately, never commit them.
# 复制到本目录 .env；用 scripts/configure.py 生成本地随机令牌。禁止提交真实秘密。
SAFETY_USER_TOKEN=
SAFETY_DEVICE_TOKENS=
SAFETY_DEVICE_ID=camera_001
SAFETY_DEVICE_TOKEN=
SAFETY_DATABASE_URL='sqlite:///./runtime/safety.db'
SAFETY_DATA_DIR='runtime'
SAFETY_REVIEW_MODE=mock
SAFETY_PUSH_MODE=mock
SAFETY_QWEN_MODEL=qwen3-vl-plus
SAFETY_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
SAFETY_ALLOW_CLOUD_IMAGES=false
SAFETY_FIREBASE_CREDENTIALS=
SAFETY_ESCALATION_SECONDS=120
SAFETY_OFFLINE_SECONDS=60
SAFETY_DEDUP_SECONDS=30
SAFETY_EVIDENCE_TTL_SECONDS=86400
SAFETY_RETRY_SECONDS=5
SAFETY_REVIEW_INTERVAL_SECONDS=5
SAFETY_REQUEST_TIMEOUT_SECONDS=20
SAFETY_MAX_ATTEMPTS=3
# 仅填用户自行核实的 URL，不猜 TP-LINK 固件路径。勿提交。
RTSP_URL=
POSE_WEIGHTS='weights/yolo11n-pose.pt'
FIRE_WEIGHTS='weights/luminous-fire-yolov8n.pt'
